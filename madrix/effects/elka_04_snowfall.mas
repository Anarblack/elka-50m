@scriptname="Elka 50m - snowfall";
@author="ChuDo / elka-50m";
@version="1.0";
@description="White streaks falling down the tree on a deep blue base. For the 2D cylinder patch elka50_madrix_2d_cylinder.csv: X = around the tree (front in the middle), Y = height (0 = top).";

// ---- settings ----
const float SPEED  = 1.0;   // 1.0 = same tempo as the web model
const float BRIGHT = 1.0;   // 0..1 master for this effect
const float TREE_H = 50.0;  // tree height with star, m
const float TREE_R = 9.0;   // radius of the lowest tier, m

color col;
int W;
int H;

float flr(float x) { float m = fmod(x, 1.0); float r = x - m; if(m < 0.0) r = r - 1.0; return r; }
float fract(float x) { return x - flr(x); }
float h11(float n) { return fract(sin(n*12.9898)*43758.5453); }
float sstep(float a, float b, float x) { float t = fclamp((x - a)/(b - a), 0.0, 1.0); return t*t*(3.0 - 2.0*t); }
void put(int x, int y, float r, float g, float b)
{
  col.r = round(fclamp(r*BRIGHT, 0.0, 1.0)*255.0);
  col.g = round(fclamp(g*BRIGHT, 0.0, 1.0)*255.0);
  col.b = round(fclamp(b*BRIGHT, 0.0, 1.0)*255.0);
  SetPixel(col, x, y);
}
float now() { float ms = GetEffectTime(); return ms/1000.0*SPEED; }

void InitEffect() { W = GetMatrixWidth(); H = GetMatrixHeight(); col = BLACK; }
void MatrixSizeChanged() { InitEffect(); }

void RenderEffect()
{
  float t = now();
  int x; int y;
  for(x = 0; x < W; x++) {
    float v1 = 4.0 + h11(x*1.7)*5.0;
    float v2 = 4.0 + h11(x*1.7 + 900.0)*5.0;
    float head1 = TREE_H + 4.0 - fmod(t*v1 + h11(x*3.1)*300.0, TREE_H + 12.0);
    float head2 = TREE_H + 4.0 - fmod(t*v2 + h11(x*3.1 + 500.0)*300.0, TREE_H + 12.0);
    for(y = 0; y < H; y++) {
      float ym = (1.0 - (y + 0.5)/H)*TREE_H;
      float s = 0.0;
      float d = ym - head1;
      if(d >= 0.0) s = s + pow(2.7182818, -d*0.8); else s = s + pow(2.7182818, d*6.0);
      d = ym - head2;
      if(d >= 0.0) s = s + pow(2.7182818, -d*0.8); else s = s + pow(2.7182818, d*6.0);
      s = s*0.75;
      put(x, y, 0.02 + 0.85*s, 0.04 + 0.93*s, 0.11 + 1.0*s);
    }
  }
}
